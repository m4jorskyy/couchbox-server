{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CouchBox",
  "version": "0.1.0",
  "identifier": "com.couchbox.tv",
  "build": {
    "beforeDevCommand": "npm --prefix ../../WebstormProjects/couchbox-web run dev:tv",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../WebstormProjects/couchbox-web run build",
    "frontendDist": "../../WebstormProjects/couchbox-web/apps/tv-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CouchBox TV",
        "width": 1280,
        "height": 720,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#090B10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
